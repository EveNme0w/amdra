ANTHROPIC_API_KEY=sk-ant-...
# "anthropic" calls Claude; "offline" uses the deterministic rule-based reasoner (no key needed)
AMDRA_LLM=anthropic
# Check https://docs.claude.com/en/docs/about-claude/models for current model IDs
AMDRA_MODEL=claude-sonnet-4-5
# "chroma" (persistent) or "memory" (in-process, used by tests)
AMDRA_VECTOR_BACKEND=chroma
# "chroma-default" (MiniLM ONNX, downloaded on first use) or "hashing" (offline, deterministic)
AMDRA_EMBEDDER=chroma-default
# "auto" uses tesseract if installed, else the ground-truth sidecar text
AMDRA_OCR=auto
# 1/true/yes to fuse BM25 lexical search with dense retrieval (reciprocal rank fusion); unset/off by default
AMDRA_HYBRID_RETRIEVAL=
# "fixed" (default, deterministic pipeline) or "react" (M3c's opt-in ReAct investigator, ablation only)
AMDRA_INVESTIGATOR=fixed

# Optional: LangSmith tracing (M3a). langsmith is already installed (a langchain-core dependency),
# so setting these needs no new package — every ChatAnthropic/graph invocation is traced automatically.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=amdra
